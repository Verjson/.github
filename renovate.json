{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Maintain digest pins in Node workflow/setup surfaces",
      "matchManagers": ["github-actions"],
      "matchFileNames": [
        ".github/actions/setup-verjson-node/action.yml",
        ".github/workflows/actions-ci.yml",
        ".github/workflows/node-cache-integration.yml",
        ".github/workflows/node-ci.yml",
        ".github/workflows/node-release.yml"
      ],
      "pinDigests": true
    }
  ]
}
