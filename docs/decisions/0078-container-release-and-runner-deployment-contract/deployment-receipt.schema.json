{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Verjson/.github/blob/main/docs/decisions/0078-container-release-and-runner-deployment-contract/deployment-receipt.schema.json",
  "title": "Verjson runner deployment receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "attemptId",
    "action",
    "deploymentContractCommit",
    "headCommit",
    "headTree",
    "planDigest",
    "outcome",
    "environment",
    "manifestIdentity",
    "fleetSelector",
    "canaryRunner",
    "selectedRelease",
    "observedDeployedRelease",
    "previousReceiptDigest",
    "rollbackOfAttempt",
    "authorization",
    "runners",
    "finalFleet",
    "failure",
    "observedAt",
    "startedAt",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": {"const": 4},
    "revision": {"type": "integer", "minimum": 0},
    "attemptId": {"type": "string", "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*$"},
    "action": {"enum": ["deploy", "rollback"]},
    "deploymentContractCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "headCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "headTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "planDigest": {"$ref": "#/$defs/digest"},
    "outcome": {"enum": ["admitted", "in_progress", "succeeded", "failed", "interrupted"]},
    "environment": {"const": "production"},
    "manifestIdentity": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fleetSelector": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{1,31}$"},
    "canaryRunner": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "selectedRelease": {"$ref": "#/$defs/release"},
    "observedDeployedRelease": {
      "description": "Release verified on the fleet immediately before mutation; null only for an admitted first deployment.",
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/release"}]
    },
    "previousReceiptDigest": {
      "description": "Digest of the preceding append-only revision; null only for the admitted pre-mutation receipt.",
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
    },
    "rollbackOfAttempt": {
      "description": "Exact failed or interrupted attempt whose observed baseline is selected for rollback.",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["attemptId", "receiptDigest"],
          "properties": {
            "attemptId": {"type": "string", "pattern": "^[1-9][0-9]*\\.[1-9][0-9]*$"},
            "receiptDigest": {"$ref": "#/$defs/digest"}
          }
        }
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "repositoryId", "defaultBranch", "ref", "deployedCommit", "deployedTree", "environment", "deploymentBranchPolicy", "requiredReviewers", "preventSelfReview", "canAdminsBypass", "dispatcher", "dispatcherId", "triggeringActor", "triggeringActorId", "environmentBypassed", "bypassBasis", "workflowRunId", "workflowRunAttempt", "repository", "pullRequest", "reviewedHead", "reviewedTree", "patchDigest", "reviewGates"],
      "properties": {
        "source": {"const": "github-api"},
        "repositoryId": {"type": "integer", "minimum": 1},
        "defaultBranch": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "deployedCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "deployedTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "environment": {"const": "production"},
        "deploymentBranchPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protectedBranches", "customBranchPolicies"],
          "properties": {
            "protectedBranches": {"const": true},
            "customBranchPolicies": {"const": false}
          }
        },
        "requiredReviewers": {"type": "array", "maxItems": 0},
        "preventSelfReview": {"const": false},
        "canAdminsBypass": {"const": true},
        "dispatcher": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"},
        "dispatcherId": {"type": "integer", "minimum": 1},
        "triggeringActor": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"},
        "triggeringActorId": {"type": "integer", "minimum": 1},
        "environmentBypassed": {"type": "boolean"},
        "bypassBasis": {"const": "branch-policy-only"},
        "workflowRunId": {"type": "integer", "minimum": 1},
        "workflowRunAttempt": {"type": "integer", "minimum": 1},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "pullRequest": {"type": "integer", "minimum": 1},
        "reviewedHead": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "reviewedTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "patchDigest": {"$ref": "#/$defs/digest"},
        "reviewGates": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/reviewGate"}
        }
      }
    },
    "runners": {
      "type": "array",
      "items": {"$ref": "#/$defs/runnerTransition"}
    },
    "finalFleet": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "release", "state"],
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "release": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/release"}]},
          "state": {"enum": ["verified", "unknown"]}
        }
      }
    },
    "failure": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1}]},
    "observedAt": {"type": "string", "format": "date-time"},
    "startedAt": {"type": "string", "format": "date-time"},
    "completedAt": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]}
  },
  "allOf": [
    {
      "if": {"properties": {"action": {"const": "deploy"}}},
      "then": {"properties": {"rollbackOfAttempt": {"type": "null"}}}
    },
    {
      "if": {"properties": {"action": {"const": "rollback"}}},
      "then": {
        "properties": {
          "rollbackOfAttempt": {"type": "object"},
          "observedDeployedRelease": {"type": "object"}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "admitted"}}},
      "then": {
        "properties": {
          "revision": {"const": 0},
          "runners": {"type": "array", "maxItems": 0},
          "completedAt": {"type": "null"},
          "previousReceiptDigest": {"type": "null"},
          "failure": {"type": "null"}
        }
      },
      "else": {"properties": {"previousReceiptDigest": {"type": "string"}}}
    },
    {
      "if": {"properties": {"outcome": {"enum": ["failed", "interrupted"]}}},
      "then": {"properties": {"failure": {"type": "string"}}},
      "else": {"properties": {"failure": {"type": "null"}}}
    }
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reviewGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "principalId", "appId", "issuer", "checkRunId", "workflowRunId", "workflowRunAttempt", "workflowPath", "workflowRef", "artifactId", "artifactDigest", "evidenceDigest", "repositoryId", "repository", "pullRequest", "headCommit", "headTree", "patchDigest", "conclusion", "completedAt"],
      "properties": {
        "kind": {"enum": ["code", "security", "ai"]},
        "principalId": {"type": "integer", "minimum": 1},
        "appId": {"type": "integer", "minimum": 1},
        "issuer": {"type": "string", "minLength": 1},
        "checkRunId": {"type": "integer", "minimum": 1},
        "workflowRunId": {"type": "integer", "minimum": 1},
        "workflowRunAttempt": {"type": "integer", "minimum": 1},
        "workflowPath": {"type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"},
        "workflowRef": {"type": "string", "minLength": 1},
        "artifactId": {"type": "integer", "minimum": 1},
        "artifactDigest": {"$ref": "#/$defs/digest"},
        "evidenceDigest": {"$ref": "#/$defs/digest"},
        "repositoryId": {"type": "integer", "minimum": 1},
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "pullRequest": {"type": "integer", "minimum": 1},
        "headCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "headTree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "patchDigest": {"$ref": "#/$defs/digest"},
        "conclusion": {"const": "success"},
        "completedAt": {"type": "string", "format": "date-time"}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseVersion", "manifestDigest"],
      "properties": {
        "releaseVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "manifestDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "runnerTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "beforeDigest", "afterDigest", "afterRelease", "state", "probe", "observation", "completedAt"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "beforeDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "afterDigest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "afterRelease": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/release"}]},
        "state": {"enum": ["updated", "restored", "reconciled", "unknown"]},
        "probe": {"enum": ["not_run", "passed", "failed", "timeout"]},
        "observation": {"enum": ["not_required", "pending", "passed"]},
        "completedAt": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]}
      }
    }
  }
}
