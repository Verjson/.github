{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Verjson/.github/container-candidate-manifest.schema.json",
  "title": "Verjson immutable container candidate manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "candidateVersion", "source", "images"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "container-candidate"},
    "candidateVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-rc\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "source": {
      "type": "object",
      "required": ["repository", "commit", "ref", "workflow", "runId", "runAttempt"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "ref": {"const": "refs/heads/main"},
        "workflow": {"type": "string"},
        "runId": {"type": "string", "pattern": "^[0-9]+$"},
        "runAttempt": {"type": "string", "pattern": "^[0-9]+$"}
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["variant", "repository", "indexDigest", "identities", "platforms", "provenance", "sbom"],
        "properties": {
          "variant": {"type": "string"},
          "repository": {"type": "string"},
          "indexDigest": {"$ref": "#/$defs/digest"},
          "identities": {
            "type": "object",
            "required": ["commit", "candidate"],
            "properties": {"commit": {"type": "string"}, "candidate": {"type": "string"}}
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["os", "architecture", "digest"],
              "properties": {
                "os": {"type": "string"}, "architecture": {"type": "string"},
                "variant": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}
              }
            }
          },
          "provenance": {"$ref": "#/$defs/attestation"},
          "sbom": {"$ref": "#/$defs/attestation"},
          "base": {
            "type": "object",
            "required": ["variant", "digest"],
            "properties": {"variant": {"type": "string"}, "digest": {"$ref": "#/$defs/digest"}}
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "attestation": {
      "type": "object",
      "required": ["subjectDigest"],
      "properties": {
        "subjectDigest": {"$ref": "#/$defs/digest"},
        "attestationId": {"type": "string", "minLength": 1},
        "ociSubject": {"type": "string", "minLength": 1}
      }
    }
  }
}
