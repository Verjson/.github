{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Verjson/.github/blob/main/docs/changelog/fragment.schema.json",
  "title": "Verjson changelog fragment metadata",
  "$defs": {
    "immutableReleaseText": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "not": {
        "anyOf": [
          {
            "pattern": "^\"(?:[^\"\\\\]|\\\\[\\s\\S])*\"[\\s\\S]*\"$"
          },
          {
            "pattern": "^'(?:[^']|'')*'(?!')[\\s\\S]*'$"
          },
          {
            "pattern": "^'(?:[^']|'')*''$"
          }
        ]
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "title"
  ],
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "pattern": "^(?:[0-9]{8}T[0-9]{6}Z|[0-9a-fA-F]{6,12})$"
    },
    "title": {
      "$ref": "#/$defs/immutableReleaseText"
    },
    "refs": {
      "type": "string",
      "pattern": "^#?[1-9][0-9]*(\\s*,\\s*#?[1-9][0-9]*)*$",
      "description": "Comma-separated issue numbers this entry links but does not own. Identity must stay unique, so only one entry per issue carries `issue:`; `refs` lets the other entries for that issue keep their release back-link."
    },
    "summary": {
      "allOf": [
        {
          "$ref": "#/$defs/immutableReleaseText"
        },
        {
          "pattern": "\\S"
        }
      ]
    },
    "component": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$(?![\\s\\S])"
    },
    "impact": {
      "type": "string",
      "enum": [
        "patch",
        "minor",
        "major"
      ]
    }
  },
  "oneOf": [
    {
      "required": [
        "issue"
      ],
      "not": {
        "required": [
          "id"
        ]
      }
    },
    {
      "required": [
        "id"
      ],
      "not": {
        "required": [
          "issue"
        ]
      }
    }
  ]
}
