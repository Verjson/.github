.tokensave/

# Claude Code tooling residue — scratch worktrees and per-machine settings, never
# part of the repo. Scoped rather than ignoring all of .claude/ so shared agent
# or skill config can still be committed later.
.claude/worktrees/
.claude/settings.local.json
.claude/.headroom_wrap_marker.json

# PM orchestrator run state — a plan and run brief written per session and deleted
# at terminal completion. Scratch, like the worktrees above, never repo content.
.pm-*

# Byte-code left behind by running scripts/changelog.test.py.
__pycache__/
