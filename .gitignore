# Symbol-index residue. Both are per-machine caches of this tree, rebuilt on
# demand, and the provider has already changed once — so the whole directory is
# ignored rather than the subset each vendor happens to exclude. Serena's own
# .serena/.gitignore keeps project.yml committable; we go further deliberately,
# because a committed index goes stale silently and is 2.3 MB of churn.
.tokensave/
.serena/

# Claude Code tooling residue — scratch worktrees and per-machine settings, never
# part of the repo. Scoped rather than ignoring all of .claude/ so shared agent
# or skill config can still be committed later.
.claude/worktrees/
.claude/settings.local.json
.claude/.headroom_wrap_marker.json

# The other half of the same residue: Claude Code writes its scratch checkouts to
# .claude/worktrees/, while the Codex and plain `git worktree` flows write here.
# Only the first was ignored, so every agent run through the second left `git
# status` reporting an untracked .worktrees/ that no sweep could clear — a
# standing false signal competing with real uncommitted work.
.worktrees/

# PM orchestrator run state — a plan and run brief written per session and deleted
# at terminal completion. Scratch, like the worktrees above, never repo content.
.pm-*

# Byte-code left behind by running scripts/changelog.test.py.
__pycache__/

# Dependency trees installed by scripts/release-tooling-audit.sh when it runs the
# supply-chain gate. ~30 MB of per-machine install, rebuilt from the lockfile on
# demand, and untracked it would otherwise show up in every `git status` here.
node_modules/
